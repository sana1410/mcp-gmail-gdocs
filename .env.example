# Required: Google OAuth credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Transport mode: "stdio" (default) or "http"
MCP_TRANSPORT=stdio

# HTTP mode settings
HTTP_HOST=127.0.0.1
HTTP_PORT=3000
PUBLIC_BASE_URL=

# OAuth redirect URI (for auth CLI flow)
GOOGLE_REDIRECT_URI=http://127.0.0.1:3456/oauth2callback

# Token storage path (default: OS config dir)
# TOKEN_STORE_PATH=

# Remote deployment: base64-encoded tokens.json (run locally: base64 -w0 tokens.json)
# Bootstraps the token file on first start when no file exists on disk.
# GOOGLE_TOKENS_BASE64=

# Allowed origins for HTTP mode (comma-separated)
# ALLOWED_ORIGINS=http://localhost:3000

# Safety: recipient allow-lists (comma-separated, optional)
# ALLOWED_RECIPIENTS=alice@example.com,bob@example.com
# ALLOWED_RECIPIENT_DOMAINS=example.com,mycompany.com

# Safety: document allow-list (comma-separated doc IDs, optional)
# ALLOWED_DOCUMENT_IDS=

# Rate limits
MAX_EMAILS_PER_HOUR=20
MAX_EMAILS_PER_DAY=100
MAX_APPENDS_PER_HOUR=100

# Size limits (bytes)
MAX_BODY_SIZE_BYTES=102400
MAX_APPEND_SIZE_BYTES=51200
MAX_RECIPIENTS=25

# Logging: error | warn | info | debug
LOG_LEVEL=info
